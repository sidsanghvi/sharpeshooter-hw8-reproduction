{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["searched", "registered", "consumed", "no_work"]
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000}
  }
}
